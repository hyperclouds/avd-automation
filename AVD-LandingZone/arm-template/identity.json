{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "location": {
        "type": "string",
        "defaultValue": "[resourceGroup().location]",
        "metadata": {
          "description": "Location for AADDS deployment"
        }
      },
      "aadDomainName": {
        "type": "string",
        "defaultValue": "hyperclouds.nl",
        "metadata": {
          "description": "The custom domain name for Azure AD Domain Services"
        }
      },
      "adminUsername": {
        "type": "string",
        "metadata": {
          "description": "The username for the AVD administrators group"
        }
      },
      "adminObjectId": {
        "type": "string",
        "metadata": {
          "description": "The Object ID of the administrator in Azure AD"
        }
      },
      "rbacRole": {
        "type": "string",
        "defaultValue": "Virtual Machine Administrator Login",
        "metadata": {
          "description": "The RBAC role to assign to the AVD admins"
        }
      }
    },
    "resources": [
      {
        "type": "Microsoft.AAD/domainServices",
        "apiVersion": "2021-03-01",
        "name": "[parameters('aadDomainName')]",
        "location": "[parameters('location')]",
        "properties": {
          "domainName": "[parameters('aadDomainName')]",
          "filteredSync": "Enabled",
          "syncScope": "All",
          "ldapsSettings": {
            "ldaps": "Disabled"
          }
        }
      },
      {
        "type": "Microsoft.Authorization/roleAssignments",
        "apiVersion": "2020-04-01-preview",
        "name": "[guid(parameters('adminObjectId'), parameters('rbacRole'))]",
        "properties": {
          "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('rbacRole'))]",
          "principalId": "[parameters('adminObjectId')]",
          "scope": "[resourceGroup().id]"
        }
      }
    ],
    "outputs": {
      "aadDomainName": {
        "type": "string",
        "value": "[parameters('aadDomainName')]"
      }
    }
  }
  