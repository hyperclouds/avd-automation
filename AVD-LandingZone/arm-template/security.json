{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "location": {
        "type": "string",
        "defaultValue": "[resourceGroup().location]",
        "metadata": {
          "description": "Location for security services"
        }
      },
      "logAnalyticsWorkspaceId": {
        "type": "string",
        "metadata": {
          "description": "Resource ID of the Log Analytics workspace for security logging"
        }
      }
    },
    "resources": [
      {
        "type": "Microsoft.Security/pricings",
        "apiVersion": "2021-06-01",
        "name": "default",
        "properties": {
          "tier": "Standard"
        }
      },
      {
        "type": "Microsoft.OperationsManagement/solutions",
        "apiVersion": "2015-11-01-preview",
        "name": "[concat('SecurityInsights(', resourceGroup().location, ')')]",
        "location": "[parameters('location')]",
        "properties": {
          "workspaceResourceId": "[parameters('logAnalyticsWorkspaceId')]"
        }
      }
    ],
    "outputs": {
      "securityStatus": {
        "type": "string",
        "value": "Microsoft Defender for Cloud enabled"
      }
    }
  }
  